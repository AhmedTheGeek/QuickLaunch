<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Makes every app's MAIN/LAUNCHER activity visible on API 30+ without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the clipboard-link row show the icon of the app that will open the link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Special permission granted by the user under Settings > Usage access; powers "most used apps". -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".QuickLaunchApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickLaunch"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Entry point for gesture apps and shortcuts. Never draws; shows the overlay or the fallback activity. -->
        <activity
            android:name=".EntryActivity"
            android:exported="true"
            android:launchMode="standard"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LaunchActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateVisible|adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|density|locale|layoutDirection"
            android:theme="@style/Theme.QuickLaunch" />

        <!-- Prominent disclosure shown before the user is sent to enable the accessibility service. -->
        <activity
            android:name=".shortcut.ShortcutDisclosureActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.QuickLaunch" />

        <!-- Global Ctrl+Space. Key filtering only; subscribes to no accessibility events. -->
        <service
            android:name=".shortcut.KeyboardShortcutService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>

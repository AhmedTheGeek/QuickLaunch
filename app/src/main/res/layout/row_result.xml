<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Keycap chip, shown on the selected row only. -->
    <ImageView
        android:id="@+id/enter"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:minWidth="26dp"
        android:background="@drawable/bg_keycap"
        android:contentDescription="@null"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:src="@drawable/ic_return"
        android:tint="@color/text_secondary"
        android:visibility="invisible" />

    <!--
      Pin toggle. Always laid out at 48dp so the touch target never moves or resizes; only its alpha
      and glyph change (faint outline on idle rows, full outline on the selected row, filled when
      pinned). Its own click target, so a tap here toggles instead of launching the row.
    -->
    <ImageView
        android:id="@+id/pin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_dismiss"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/pin"
        android:padding="12dp"
        android:src="@drawable/ic_pin_outline"
        android:tint="@color/text_secondary" />
</LinearLayout>

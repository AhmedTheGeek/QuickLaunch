<?xml version="1.0" encoding="utf-8"?>
<!--
  One-time setup prompt. Same height and inset as a result row so it reads as part of the list,
  but with an icon tile, two lines of copy and its own dismiss.
  Tapping the row opens the relevant system setting; × hides it for good.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/setup_icon"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:background="@drawable/bg_icon_placeholder"
        android:contentDescription="@null"
        android:padding="9dp"
        android:tint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/setup_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/setup_dismiss"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_dismiss"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/setup_dismiss"
        android:padding="9dp"
        android:src="@drawable/ic_close"
        android:tint="@color/text_hint" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuickLaunch" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/NoWindowAnim</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:colorControlActivated">@color/cursor</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <!-- Elevation shadows are faint by default; deepen them so the card visibly floats over the dimmed app. -->
        <item name="android:ambientShadowAlpha">0.12</item>
        <item name="android:spotShadowAlpha">0.45</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!-- One action line in the row context menu: glyph, gap, label; pressed state from bg_row. -->
    <style name="MenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/menu_item_height</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:drawableTint">@color/text_secondary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NoWindowAnim">
        <item name="android:activityOpenEnterAnimation">@anim/ql_none</item>
        <item name="android:activityOpenExitAnimation">@anim/ql_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/ql_none</item>
        <item name="android:activityCloseExitAnimation">@anim/ql_none</item>
        <item name="android:taskOpenEnterAnimation">@anim/ql_none</item>
        <item name="android:taskOpenExitAnimation">@anim/ql_none</item>
        <item name="android:taskCloseEnterAnimation">@anim/ql_none</item>
        <item name="android:taskCloseExitAnimation">@anim/ql_none</item>
        <item name="android:taskToFrontEnterAnimation">@anim/ql_none</item>
        <item name="android:taskToFrontExitAnimation">@anim/ql_none</item>
        <item name="android:taskToBackEnterAnimation">@anim/ql_none</item>
        <item name="android:taskToBackExitAnimation">@anim/ql_none</item>
        <item name="android:wallpaperOpenEnterAnimation">@anim/ql_none</item>
        <item name="android:wallpaperOpenExitAnimation">@anim/ql_none</item>
        <item name="android:wallpaperCloseEnterAnimation">@anim/ql_none</item>
        <item name="android:wallpaperCloseExitAnimation">@anim/ql_none</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@anim/ql_none</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@anim/ql_none</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@anim/ql_none</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@anim/ql_none</item>
        <item name="android:windowEnterAnimation">@anim/ql_none</item>
        <item name="android:windowExitAnimation">@anim/ql_none</item>
        <item name="android:windowShowAnimation">@anim/ql_none</item>
        <item name="android:windowHideAnimation">@anim/ql_none</item>
    </style>
</resources>
